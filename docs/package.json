{
  "name": "stellar-stream-hive-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for Stellar Stream Hive (contracts + API + web app).",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-search-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-links": "node scripts/check-links.mjs",
    "check-external-links": "node scripts/check-external-links.mjs",
    "check-nav": "node scripts/check-nav.mjs",
    "check-metadata": "node scripts/check-metadata.mjs",
    "lint:md": "markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#.next\"",
    "spellcheck": "cspell \"**/*.{md,mdx,ts,tsx}\" --config cspell.json --no-progress",
    "a11y": "pa11y-ci --config .pa11yci.json",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "^14.2.35",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "markdownlint-cli2": "^0.14.0",
    "cspell": "^8.14.4",
    "pa11y-ci": "^3.1.0",
    "wait-on": "^7.2.0",
    "@lhci/cli": "^0.14.0"
  }
}
